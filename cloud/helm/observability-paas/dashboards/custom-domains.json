			"pluginVersion": "12.4.2",
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "sum by (hostname) (\n  last_over_time(kube_customresource_httproute_info[1h])\n  and on (exported_namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\"}[1h])\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "A"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "group by (hostname, condition) (\n  (\n    last_over_time(kube_customresource_certificate_dnsname_info[1h])\n    and on (exported_namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\"}[1h])\n  )\n  * on (name, exported_namespace) group_left(condition)\n  (last_over_time(certmanager_certificate_ready_status[1h]) > 0)\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "B"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "sum by (hostname) (\n  (\n    last_over_time(kube_customresource_certificate_dnsname_info[1h])\n    and on (exported_namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\"}[1h])\n  )\n  * on (name, exported_namespace) group_left\n  last_over_time(certmanager_certificate_expiration_timestamp_seconds[1h])\n) * 1000",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "C"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "group by (hostname, reason) (\n  label_replace(\n    last_over_time(certmanager_certificate_challenge_status[1h]) == 1,\n    \"hostname\", \"$1\", \"domain\", \"(.+)\"\n  )\n  and on (exported_namespace, hostname) (\n    last_over_time(kube_customresource_certificate_dnsname_info{hostname!~\".+\\\\.${dns_zone}\"}[1h])\n    and on (exported_namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\"}[1h])\n  )\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "D"
				}
			],
			"title": "Custom Domains",
			"transformations": [
